{
  "$schema": "https://wellmanifest.com/schemas/autonomy-manifest/v6",
  "schema": "wellmanifest.autonomy/manifest/v6",
  "id": "subactor://autonomy/project/example-api",
  "version": "1.0.0",
  "status": "active",
  "subject": {
    "repository": "example/example-api",
    "defaultBranch": "main",
    "adoptedRevision": "1111111111111111111111111111111111111111",
    "policyDigest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "profile": {
      "id": "wellmanifest.autonomy.profile/subactor-semcod",
      "version": "0.8.0",
      "digest": "sha256:38a86b64d35ee1e58e208a9fad6e335d3f06cdd2faf37b83c55a4e911b0986b1"
    }
  },
  "grant": {
    "id": "subactor://grant/autonomy/example-api/2026-08",
    "issuer": {
      "id": "authority:founder",
      "kind": "human"
    },
    "issuedAt": "2026-08-14T08:00:00Z",
    "notBefore": "2026-08-14T08:00:00Z",
    "reviewAt": "2026-08-28T08:00:00Z",
    "expiresAt": "2026-09-14T08:00:00Z",
    "scope": {
      "repositories": ["example/example-api"],
      "branches": ["main"],
      "pathAllow": ["src/**", "tests/**", "docs/**"],
      "pathDeny": [
        ".github/**",
        ".governance/**",
        ".wellmanifest/**",
        "infra/**",
        "secrets/**"
      ],
      "actions": [
        "observe",
        "trigger-cycle",
        "claim-cycle",
        "reconcile-cycle",
        "select-task",
        "propose-plan",
        "create-ticket",
        "create-branch",
        "edit-candidate",
        "test-candidate",
        "commit-candidate",
        "push-candidate",
        "open-pull-request",
        "issue-validator-attestation",
        "approve-via-validator-app",
        "merge-pull-request",
        "post-merge-read-back",
        "append-audit-receipt"
      ],
      "riskCeiling": "moderate"
    },
    "constraints": {
      "noPerPullRequestHumanApproval": true,
      "allowAutomatedMerge": true,
      "selfExtension": false,
      "selfRenewal": false,
      "killSwitch": "AUTONOMY_MUTATIONS_ENABLED",
      "killSwitchExpected": "1"
    }
  },
  "fleet": {
    "roles": [
      {
        "id": "agent:doctor",
        "role": "observer",
        "principal": "principal:doctor-app",
        "provider": "subactor/autonom",
        "model": null,
        "authorities": ["observe"],
        "forbiddenAuthorities": ["edit-candidate", "merge-pull-request"],
        "workspaceIsolation": "read-only"
      },
      {
        "id": "agent:dispatcher",
        "role": "dispatcher",
        "principal": "principal:dispatcher-app",
        "provider": "subactor/autonom",
        "model": null,
        "authorities": ["trigger-cycle", "claim-cycle", "reconcile-cycle"],
        "forbiddenAuthorities": ["edit-candidate", "approve-via-validator-app", "merge-pull-request"],
        "workspaceIsolation": "protected-service"
      },
      {
        "id": "agent:planner",
        "role": "planner",
        "principal": "principal:planner-app",
        "provider": "subactor/orchestrator",
        "model": "openrouter/planner",
        "authorities": ["select-task", "propose-plan"],
        "forbiddenAuthorities": ["edit-candidate", "approve-via-validator-app", "merge-pull-request"],
        "workspaceIsolation": "read-only"
      },
      {
        "id": "agent:repair",
        "role": "implementer",
        "principal": "principal:repair-app",
        "provider": "subactor/repair-agent",
        "model": "openai/codex",
        "authorities": [
          "create-ticket",
          "create-branch",
          "edit-candidate",
          "test-candidate",
          "commit-candidate",
          "push-candidate"
        ],
        "forbiddenAuthorities": ["issue-validator-attestation", "approve-via-validator-app", "merge-pull-request"],
        "workspaceIsolation": "dedicated-worktree"
      },
      {
        "id": "agent:validator",
        "role": "validator",
        "principal": "principal:validator-app",
        "provider": "subactor/validator-agent",
        "model": "openrouter/validator",
        "authorities": ["issue-validator-attestation", "approve-via-validator-app"],
        "forbiddenAuthorities": ["edit-candidate", "commit-candidate", "push-candidate", "merge-pull-request"],
        "workspaceIsolation": "fresh-checkout"
      },
      {
        "id": "agent:publisher",
        "role": "publisher",
        "principal": "principal:publisher-app",
        "provider": "subactor/onedev-agent",
        "model": null,
        "authorities": [
          "open-pull-request",
          "merge-pull-request",
          "post-merge-read-back"
        ],
        "forbiddenAuthorities": ["edit-candidate", "issue-validator-attestation"],
        "workspaceIsolation": "protected-service"
      },
      {
        "id": "agent:auditor",
        "role": "auditor",
        "principal": "principal:audit-app",
        "provider": "subactor/skills-agent",
        "model": null,
        "authorities": ["observe", "append-audit-receipt"],
        "forbiddenAuthorities": ["edit-candidate", "approve-via-validator-app", "merge-pull-request"],
        "workspaceIsolation": "protected-service"
      }
    ],
    "separation": [
      {
        "left": "agent:repair",
        "right": "agent:validator",
        "dimensions": ["principal", "credential", "workspace", "approval-identity"]
      },
      {
        "left": "agent:repair",
        "right": "agent:publisher",
        "dimensions": ["principal", "credential", "workspace", "approval-identity"]
      },
      {
        "left": "agent:validator",
        "right": "agent:publisher",
        "dimensions": ["principal", "credential", "workspace", "approval-identity"]
      }
    ]
  },
  "riskPolicy": {
    "autonomousTiers": ["low", "moderate"],
    "escalatedTiers": ["high", "critical"],
    "excludedEffects": [
      "secrets",
      "destructive-infrastructure",
      "billing",
      "legal",
      "identity-and-access",
      "security-boundary",
      "authority-policy",
      "grant-mutation",
      "force-push",
      "history-rewrite",
      "direct-default-branch-push",
      "untrusted-dependency-publish"
    ]
  },
  "budgets": {
    "maxFilesPerChange": 15,
    "maxComponentsPerChange": 5,
    "maxPublicInterfacesPerChange": 3,
    "maxRuntimeDependenciesPerChange": 3,
    "maxMinutesPerCycle": 30,
    "maxCostUsdPerCycle": 5.0,
    "maxRetriesPerTask": 2,
    "maxConsecutiveCycles": 20,
    "maxConcurrentTasks": 1,
    "cooldownSeconds": 60,
    "leaseSeconds": 1800
  },
  "queue": {
    "source": "composite",
    "selection": "runnable-priority-dag",
    "freshnessSeconds": 86400,
    "deduplication": "fingerprint",
    "humanBoundaryLabels": ["human", "autonomy-frontier"],
    "oneMutationPerCycle": true,
    "durable": true,
    "delivery": "at-least-once",
    "checkpointStore": "artifact://example/example-api/autonomy-checkpoints",
    "idempotencyBindings": [
      "repository",
      "ticket",
      "correlationId",
      "headSha",
      "operation"
    ],
    "deadLetterAfterAttempts": 3,
    "resumeFromCheckpoint": true,
    "effectReconciliation": {
      "mode": "at-most-one-authoritative-effect",
      "successOutcomes": ["applied", "already-applied"],
      "duplicateOutcome": "already-applied",
      "externalReadBack": true,
      "requiredBindings": [
        "repository",
        "target",
        "headSha",
        "ticket",
        "correlationId",
        "operation",
        "externalEffectId"
      ],
      "alreadyAppliedRequiredBindings": [
        "repository",
        "pullRequest",
        "baseSha",
        "headSha",
        "operation",
        "approvalId",
        "mergeCommitSha",
        "mergedAt"
      ],
      "repeatReviewOrMerge": false,
      "closedUnmergedOutcome": "failed",
      "staleSubjectOutcome": "failed",
      "ambiguousReceiptOutcome": "failed"
    }
  },
  "executionLiveness": {
    "primaryTrigger": {
      "id": "trigger:repository-events",
      "kind": "event",
      "principal": "principal:dispatcher-app",
      "protected": true
    },
    "watchdog": {
      "id": "watchdog:autonomy-liveness",
      "kind": "independent-scheduler",
      "principal": "principal:watchdog-app",
      "protected": true,
      "maxSilenceSeconds": 3600,
      "triggerOnSilence": true
    },
    "heartbeat": {
      "expectedIntervalSeconds": 3600,
      "deliveryGraceSeconds": 1800,
      "receiptRequired": true,
      "protectedMonitor": true,
      "missedCycleReceiptRequired": true,
      "lateDeliveryPolicy": "deduplicate-with-recovery",
      "manualRecoveryRestoresLiveness": false
    },
    "invocationIdentity": {
      "correlationRequired": true,
      "providerRunIdentityRequired": true,
      "preDispatchBoundaryRequired": true,
      "postBoundaryOnly": true,
      "requiredBindings": [
        "strategy",
        "repository",
        "target",
        "headSha",
        "correlationId"
      ],
      "matrixChildCorrelationRequired": true,
      "ambiguousRunOutcome": "failed"
    },
    "independentPrincipals": true,
    "manualDispatchProvesLiveness": false,
    "missedTriggerStatus": "degraded",
    "perRepositoryIsolation": true,
    "unrelatedFailureBlocksMerge": false,
    "aggregateStatusAuthoritative": false,
    "registry": {
      "source": "artifact://example/autonomy/repository-registry",
      "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
      "protected": true,
      "singleSource": true,
      "requiredBindings": [
        "repository",
        "baseBranch",
        "requiredChecks",
        "checkProvenance",
        "validatorIdentity",
        "mergePolicy"
      ],
      "driftCheck": true
    },
    "canary": {
      "mode": "protected-low-risk-pr",
      "maximumAgeSeconds": 86400,
      "manualDispatchCounts": false,
      "requiredReceipts": [
        "scheduler-heartbeat",
        "trigger-delivery",
        "queue-claim",
        "registry-resolution",
        "check-provenance",
        "policy-convergence",
        "deterministic-validation",
        "independent-validation",
        "publication",
        "read-back",
        "branch-cleanup"
      ]
    }
  },
  "pipeline": {
    "states": [
      "dispatch",
      "claim",
      "observe",
      "evidence",
      "plan",
      "grant-check",
      "isolated-edit",
      "deterministic-validate",
      "independent-validate",
      "publish-pr",
      "exact-head-gate",
      "post-approval-convergence",
      "protected-merge",
      "post-merge-verify",
      "checkpoint",
      "continue"
    ],
    "requiredGates": [
      {
        "id": "trigger-liveness",
        "stage": "pre-cycle",
        "kind": "liveness",
        "producer": "controller.watchdog",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "queue-claim",
        "stage": "pre-cycle",
        "kind": "deterministic",
        "producer": "controller.dispatcher",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "invocation-correlation",
        "stage": "pre-cycle",
        "kind": "deterministic",
        "producer": "controller.dispatcher",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "registry-consistency",
        "stage": "pre-cycle",
        "kind": "deterministic",
        "producer": "controller.registry",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "grant-active",
        "stage": "pre-edit",
        "kind": "deterministic",
        "producer": "controller.grant",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "candidate-scope",
        "stage": "pre-push",
        "kind": "deterministic",
        "producer": "controller.scope",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "intent-history",
        "stage": "pre-edit",
        "kind": "deterministic",
        "producer": "controller.intent",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "contract-consumers",
        "stage": "pre-push",
        "kind": "deterministic",
        "producer": "controller.contracts",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "deterministic-checks",
        "stage": "pre-approval",
        "kind": "deterministic",
        "producer": "ci.required-checks",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "check-provenance",
        "stage": "pre-merge",
        "kind": "deterministic",
        "producer": "controller.registry",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "independent-validator",
        "stage": "pre-merge",
        "kind": "independent-attestation",
        "producer": "app.validator",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "exact-head-current-base",
        "stage": "pre-merge",
        "kind": "deterministic",
        "producer": "controller.publisher",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "post-approval-convergence",
        "stage": "pre-merge",
        "kind": "deterministic",
        "producer": "controller.publisher",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "effect-reconciliation",
        "stage": "pre-merge",
        "kind": "read-back",
        "producer": "controller.publisher",
        "protected": true,
        "failClosed": true
      },
      {
        "id": "post-merge-read-back",
        "stage": "post-merge",
        "kind": "read-back",
        "producer": "controller.publisher",
        "protected": true,
        "failClosed": true
      }
    ],
    "onFailure": "fail-closed",
    "onOutOfScope": "escalate"
  },
  "changeControl": {
    "intentHistory": {
      "checkpointBeforeImplementation": true,
      "immutableScope": true
    },
    "baseRefresh": {
      "acceptedBaseRequired": true,
      "revalidateAll": true,
      "historyRewrite": false,
      "mode": "successor-pull-request"
    },
    "contractMigration": {
      "exactVersionAllowlist": true,
      "resolveBeforeConsumerExecution": true,
      "unknownVersion": "fail-closed",
      "consumerInventoryRequired": true,
      "allConsumersMustPass": true,
      "requiredSurfaces": [
        "local",
        "container-image",
        "compose",
        "hosted-ci",
        "validator"
      ]
    },
    "checkProvenance": {
      "protectedRegistry": true,
      "requiredBindings": ["producer", "event", "repository", "headSha", "checkName"],
      "authoritativeProducerRequired": true,
      "duplicateContextPolicy": "reject-ambiguous",
      "nonAuthoritativeStatusBlocksMerge": false
    },
    "publicationConvergence": {
      "effectivePolicySourceProtected": true,
      "registryMustMatchEffectivePolicy": true,
      "preApprovalCheckPolicy": "terminal-success-non-circular",
      "approvalTriggeredChecksDeferred": true,
      "approvalStartsNewEpoch": true,
      "postApprovalChecksRequired": true,
      "postApprovalAttemptRequired": true,
      "terminalSuccessRequired": true,
      "minimumStableReads": 2,
      "boundedSameHeadRetry": true,
      "requiredRebindings": [
        "repository",
        "pullRequest",
        "headSha",
        "baseSha",
        "approvalId",
        "requiredCheckSet",
        "policyDigest",
        "registryDigest"
      ]
    },
    "supersededWork": {
      "sameRepositorySuccessor": true,
      "successorMergeRequired": true,
      "losslessProofRequired": true,
      "requiredBindings": [
        "predecessorRepository",
        "predecessorPullRequest",
        "predecessorHeadSha",
        "successorPullRequest",
        "successorHeadSha",
        "successorMergeSha",
        "contentDisposition",
        "receiptDigest"
      ],
      "uniqueDataPolicy": "preserve",
      "equivalentBranchDisposition": "delete-after-lossless-proof",
      "closureEffect": {
        "allowedModes": ["explicit-later", "provider-coupled"],
        "providerCoupledEffectIsSingleMutation": true,
        "explicitCloseOnlyWhenStillOpen": true,
        "requiredReadBack": [
          "branchAbsent",
          "pullRequestClosed",
          "pullRequestUnmerged",
          "archiveHeadPreserved"
        ]
      },
      "unresolvedBranchDisposition": "keep-pull-request-open",
      "standingPolicyAuthorizesProvenDeletion": true,
      "postDispositionReadBack": true
    },
    "providerReads": {
      "boundedRetries": true,
      "rateLimitStatus": "degraded",
      "fallbackMustPreserveAuthority": true
    }
  },
  "publication": {
    "mode": "pull-request",
    "approval": "trusted-validator-app",
    "requiredChecks": ["governance", "tests", "security", "validator"],
    "bindings": [
      "repository",
      "pullRequest",
      "headSha",
      "baseSha",
      "ticket",
      "grant",
      "profileDigest",
      "actor"
    ],
    "sameRepositoryOnly": true,
    "recheckBaseBeforeMerge": true,
    "autonomousMerge": true,
    "mergeMode": "protected-explicit",
    "nativeAutoMerge": false,
    "directDefaultBranchPush": false,
    "deleteBranchAfterMerge": true,
    "postMergeReadBack": true
  },
  "receipts": {
    "store": "artifact://example/example-api/autonomy-receipts",
    "required": [
      "observation",
      "trigger-delivery",
      "queue-claim",
      "registry-resolution",
      "intent-checkpoint",
      "base-refresh",
      "contract-migration",
      "check-provenance",
      "policy-convergence",
      "supersession-disposition",
      "plan",
      "grant-check",
      "change",
      "deterministic-validation",
      "independent-validation",
      "publication",
      "read-back",
      "liveness-canary",
      "branch-cleanup",
      "scheduler-heartbeat",
      "missed-cycle",
      "effect-reconciliation"
    ],
    "redaction": "secret-free",
    "retentionDays": 365
  },
  "continuation": {
    "enabled": true,
    "nextTaskWithoutHumanApproval": true,
    "closeOnlyAfterReadBack": true,
    "stopConditions": [
      "grant-revoked",
      "grant-expired",
      "kill-switch-disabled",
      "no-runnable-task",
      "out-of-scope",
      "independent-validation-failed",
      "budget-exhausted",
      "retry-exhausted",
      "ambiguous-evidence",
      "protected-authority-unavailable",
      "liveness-proof-stale",
      "registry-drift",
      "trigger-quorum-unavailable"
    ]
  }
}
